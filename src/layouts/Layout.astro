---
import '../styles/global.css'

interface Props {
  title?: string;
}

const { title = "MODEC - Decoración Integral" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    font-family: system-ui, sans-serif;
    background: #f3f4f6;
    color: #1f2937;
  }

  body {
    padding: 2rem;
  }
</style>
