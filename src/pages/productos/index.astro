---
import Layout from '../../layouts/Layout.astro';
import Encabezado from '../../components/Encabezado.astro';
import PiePagina from '../../components/PiePagina.astro';
import BotonWhatsApp from '../../components/BotonWhatsApp.astro';
import { categoriasCatalogo } from '../../data/catalogo';
import { productos, cotizar } from '../../data/modec';
import '../../styles/global.css';
import '../../styles/modec.css';

// Reutiliza las fotografías y descripciones de las tarjetas del inicio.
const categorias = categoriasCatalogo.map((categoria) => {
  const informacion = productos.find((producto) => producto.nombre === categoria.nombre);
  return {
    ...categoria,
    descripcion: informacion?.descripcion ?? 'Soluciones decorativas para tu espacio.',
    imagen: informacion?.foto ? `/images/productos/${informacion.foto}` : '',
    href: `/productos/${categoria.slug}`,
  };
});

const etiquetas = ['Control de luz', 'Textiles', 'Acabados', 'Diseño interior', 'Protección solar'];
---

<Layout title="Catálogo de productos | MODEC">
  <div class="modec">
    <Encabezado />
    <main id="contenido-catalogo">
      <section class="catalogo-portada" aria-labelledby="catalogo-titulo">
        <div class="catalogo-portada-interior">
          <nav class="catalogo-migas" aria-label="Ruta de navegación">
            <a href="/">Inicio</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Productos</span>
          </nav>

          <div class="catalogo-portada-contenido">
            <div>
              <p class="catalogo-ceja">MODEC · DECORACIÓN INTEGRAL</p>
              <h1 id="catalogo-titulo">ESPACIOS QUE<br /><em>INSPIRAN.</em></h1>
              <p class="catalogo-introduccion">
                Descubre nuestras colecciones de persianas, cortinas y acabados.
                Encuentra una solución a tu medida para cada espacio.
              </p>
              <a class="catalogo-enlace-portada" href="#categorias">
                Explorar categorías <span aria-hidden="true">↘</span>
              </a>
            </div>
            <div class="catalogo-portada-ornamento" aria-hidden="true">
              <span>MODEC</span>
              <span class="catalogo-ornamento-linea"></span>
              <span>DISEÑO · CALIDAD · ESTILO</span>
            </div>
          </div>
        </div>
      </section>

      <section class="catalogo-seccion" id="categorias" aria-labelledby="categorias-titulo">
        <div class="catalogo-contenedor">
          <div class="catalogo-seccion-encabezado">
            <div>
              <p class="catalogo-ceja catalogo-ceja-oscura">NUESTROS PRODUCTOS</p>
              <h2 id="categorias-titulo">EXPLORA LAS COLECCIONES</h2>
            </div>
            <p>Materiales, texturas y soluciones seleccionadas para transformar tus ambientes.</p>
          </div>

          <div class="catalogo-cuadricula">
            {categorias.map((categoria, indice) => (
              <a
                class:list={{ 'catalogo-tarjeta': true, 'catalogo-tarjeta-grande': indice === 0 || indice === 1 }}
                href={categoria.href}
                aria-label={`Explorar ${categoria.nombre}`}
              >
                {categoria.imagen ? (
                  <img
                    src={categoria.imagen}
                    alt={`Muestra de ${categoria.nombre.toLowerCase()} MODEC`}
                    width="1000"
                    height="800"
                    loading={indice === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                ) : null}
                <span class="catalogo-tarjeta-sombra" aria-hidden="true"></span>
                <span class="catalogo-tarjeta-numero">{String(indice + 1).padStart(2, '0')} / 05</span>
                <span class="catalogo-tarjeta-contenido">
                  <span class="catalogo-tarjeta-etiqueta">{etiquetas[indice]}</span>
                  <span class="catalogo-tarjeta-titulo">{categoria.nombre}</span>
                  <span class="catalogo-tarjeta-descripcion">{categoria.descripcion}</span>
                </span>
                <span class="catalogo-tarjeta-flecha" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
          <p class="catalogo-nota">Cada proyecto es diferente. Te ayudamos a elegir materiales, acabados y soluciones de acuerdo con tu espacio.</p>
        </div>
      </section>

      <section class="catalogo-asesoria" aria-labelledby="asesoria-titulo">
        <div class="catalogo-contenedor catalogo-asesoria-interior">
          <div>
            <p class="catalogo-ceja catalogo-ceja-oscura">TE ACOMPAÑAMOS EN TU PROYECTO</p>
            <h2 id="asesoria-titulo">¿NO SABES POR DÓNDE EMPEZAR?</h2>
            <p>Cuéntanos qué espacio quieres renovar. Te orientamos para encontrar una opción que combine con tu estilo y necesidades.</p>
          </div>
          <a
            class="catalogo-boton"
            href={cotizar('Hola, estoy viendo el catálogo de MODEC y me gustaría recibir asesoría para mi proyecto.')}
            target="_blank"
            rel="noopener noreferrer"
          >
            Solicitar asesoría <span aria-hidden="true">↗</span>
          </a>
        </div>
      </section>
    </main>
    <PiePagina />
    <BotonWhatsApp />
  </div>
</Layout>

<style>
  .catalogo-contenedor, .catalogo-portada-interior { width: min(1300px, calc(100% - 48px)); margin-inline: auto; }
  .catalogo-portada { background: #211916; color: #fff; position: relative; overflow: hidden; }
  .catalogo-portada::after { content: ''; position: absolute; width: 420px; height: 420px; border: 1px solid rgba(252,192,9,.17); border-radius: 50%; top: -160px; right: -110px; pointer-events: none; }
  .catalogo-portada-interior { position: relative; z-index: 1; padding-block: 24px 85px; }
  .catalogo-migas { display: flex; gap: 12px; align-items: center; color: #c5b6af; font: 400 12px var(--fuente-textos); }
  .catalogo-migas a { color: #f2e8df; text-decoration: none; }
  .catalogo-migas a:hover { color: var(--primario); }
  .catalogo-portada-contenido { display: flex; align-items: end; justify-content: space-between; gap: 32px; margin-top: 76px; }
  .catalogo-ceja { margin: 0 0 18px; color: var(--primario); letter-spacing: .18em; font: 700 11px var(--fuente-textos); }
  .catalogo-portada h1 { margin: 0; font: 400 clamp(47px, 7vw, 100px)/.99 var(--fuente-titulos); letter-spacing: -.025em; }
  .catalogo-portada h1 em { color: var(--primario); font-style: normal; }
  .catalogo-introduccion { max-width: 555px; margin: 24px 0 27px; color: #e0d8d3; font: 400 14px/1.85 var(--fuente-textos); }
  .catalogo-enlace-portada { display: inline-flex; align-items: center; gap: 26px; border-bottom: 1px solid var(--primario); padding-bottom: 9px; color: #fff; font: 600 13px var(--fuente-textos); text-decoration: none; }
  .catalogo-enlace-portada span { color: var(--primario); font-size: 21px; }
  .catalogo-portada-ornamento { display: flex; flex-direction: column; align-items: end; gap: 15px; flex-shrink: 0; padding-bottom: 20px; color: #d7c9c1; font: 500 10px var(--fuente-textos); letter-spacing: .12em; }
  .catalogo-portada-ornamento span:first-child { font: 400 60px var(--fuente-titulos); color: rgba(255,255,255,.13); letter-spacing: 0; }
  .catalogo-ornamento-linea { height: 1px; width: 180px; background: var(--primario); }
  .catalogo-seccion { background: #f5f3ef; padding: 85px 0 75px; }
  .catalogo-seccion-encabezado { display: flex; justify-content: space-between; align-items: end; gap: 35px; margin-bottom: 36px; }
  .catalogo-ceja-oscura { color: #986400; }
  .catalogo-seccion-encabezado h2, .catalogo-asesoria h2 { margin: 0; font: 400 clamp(29px, 3.6vw, 46px)/1.12 var(--fuente-titulos); color: #241c17; }
  .catalogo-seccion-encabezado > p { margin: 0; max-width: 330px; color: #61564e; font: 400 13px/1.75 var(--fuente-textos); }
  .catalogo-cuadricula { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 15px; }
  .catalogo-tarjeta { position: relative; display: block; grid-column: span 2; min-width: 0; min-height: 360px; overflow: hidden; background: #77675a; color: white; border-radius: 9px; isolation: isolate; text-decoration: none; }
  .catalogo-tarjeta-grande { grid-column: span 3; min-height: 420px; }
  .catalogo-tarjeta img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .55s ease; }
  .catalogo-tarjeta-sombra { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.22), rgba(0,0,0,.03) 35%, rgba(0,0,0,.79) 100%); z-index: 1; }
  .catalogo-tarjeta-numero { position: absolute; top: 23px; left: 23px; z-index: 2; font: 500 11px var(--fuente-textos); letter-spacing: .16em; }
  .catalogo-tarjeta-contenido { position: absolute; left: 24px; right: 70px; bottom: 27px; z-index: 2; display: flex; flex-direction: column; gap: 9px; }
  .catalogo-tarjeta-etiqueta { font: 600 11px var(--fuente-textos); color: #ffe5a0; letter-spacing: .08em; text-transform: uppercase; }
  .catalogo-tarjeta-titulo { font: 400 clamp(24px, 2.5vw, 36px)/1.12 var(--fuente-titulos); text-transform: uppercase; }
  .catalogo-tarjeta-descripcion { font: 400 12px/1.55 var(--fuente-textos); color: #f2eae6; }
  .catalogo-tarjeta-flecha { position: absolute; bottom: 27px; right: 24px; z-index: 2; display: grid; place-items: center; width: 40px; height: 40px; background: var(--primario); color: #18130d; border-radius: 50%; font-size: 21px; transition: transform .25s ease; }
  .catalogo-nota { margin: 25px 0 0; color: #63574f; text-align: center; font: 400 12px/1.7 var(--fuente-textos); }
  .catalogo-asesoria { background: #fcc009; padding: 49px 0; }
  .catalogo-asesoria-interior { display: flex; justify-content: space-between; align-items: center; gap: 40px; }
  .catalogo-asesoria h2 { max-width: 640px; font-size: clamp(27px, 3vw, 40px); }
  .catalogo-asesoria p:not(.catalogo-ceja) { margin: 14px 0 0; max-width: 650px; font: 400 13px/1.75 var(--fuente-textos); color: #4c3a20; }
  .catalogo-boton { flex-shrink: 0; display: inline-flex; align-items: center; justify-content: center; gap: 24px; padding: 15px 24px; min-height: 48px; background: #211916; border-radius: 30px; color: #fff !important; text-decoration: none; font: 600 13px var(--fuente-textos); }
  .catalogo-boton span { font-size: 18px; }
  .catalogo-tarjeta:focus-visible, .catalogo-boton:focus-visible, .catalogo-enlace-portada:focus-visible { outline: 3px solid #f4981a; outline-offset: 4px; }
  @media (hover: hover) and (pointer: fine) { .catalogo-tarjeta:hover img { transform: scale(1.055); } .catalogo-tarjeta:hover .catalogo-tarjeta-flecha { transform: translate(3px,-3px); } .catalogo-boton:hover { background: #3a2a23; } }
  @media (max-width: 960px) { .catalogo-tarjeta, .catalogo-tarjeta-grande { grid-column: span 3; min-height: 340px; } .catalogo-tarjeta:last-child { grid-column: span 6; min-height: 310px; } .catalogo-portada-ornamento { display: none; } }
  @media (max-width: 650px) { .catalogo-contenedor, .catalogo-portada-interior { width: min(100% - 30px, 1300px); } .catalogo-portada-interior { padding-bottom: 58px; } .catalogo-portada-contenido { margin-top: 48px; } .catalogo-portada h1 { font-size: clamp(43px, 12vw, 62px); } .catalogo-introduccion { font-size: 13px; } .catalogo-seccion { padding: 56px 0; } .catalogo-seccion-encabezado { flex-direction: column; align-items: flex-start; gap: 12px; } .catalogo-cuadricula { grid-template-columns: 1fr; gap: 13px; } .catalogo-tarjeta, .catalogo-tarjeta-grande, .catalogo-tarjeta:last-child { grid-column: 1; min-height: 330px; } .catalogo-tarjeta-titulo { font-size: 30px; } .catalogo-asesoria { padding: 45px 0; } .catalogo-asesoria-interior { flex-direction: column; align-items: flex-start; gap: 22px; } .catalogo-boton { width: 100%; } }
  @media (prefers-reduced-motion: reduce) { .catalogo-tarjeta img, .catalogo-tarjeta-flecha { transition: none; } }
</style>
