---
import Layout from '../layouts/Layout.astro';
import '../styles/modec.css';
import '../styles/modec.css';
import Encabezado from '../components/Encabezado.astro';
import Hero from '../components/Hero.astro';
import Productos from '../components/Productos.astro';
import Contacto from '../components/Contacto.astro';
import Servicios from '../components/Servicios.astro';
import Nosotros from '../components/Nosotros.astro';
import NuestroTrabajo from '../components/NuestroTrabajo.astro';
import Testimonios from '../components/Testimonios.astro';
import PiePagina from '../components/PiePagina.astro';
import BotonWhatsApp from '../components/BotonWhatsApp.astro';
---

<Layout title="MODEC | Decoración y Estilo para tus espacios">
  <div class="modec" id="inicio">

    <a class="saltar" href="#contenido">
      Saltar al contenido
    </a>

    <Encabezado />
    <BotonWhatsApp />
    <main id="contenido">
      <Hero />
      <Productos />
      <Contacto />
      <Servicios />
      <Nosotros />
      <NuestroTrabajo />
      <Testimonios />
      
    </main>
    <PiePagina />
  </div>
</Layout>
