---
import { negocio, menu } from '../data/modec';

const anio = new Date().getFullYear();
const redesActivas = negocio.redes.filter(red => red.url);
---

<footer class="pie" aria-label="Pie de página de MODEC">
  <div class="pie-contenedor">
    <div class="pie-grid">
      <!-- Marca -->
      <div class="pie-identidad">
        <a href="/" class="pie-marca" aria-label="Ir al inicio de MODEC">
          <img src="/images/logo.jpeg" alt="MODEC" width="210" height="64" loading="lazy" />
        </a>
        <p class="pie-descripcion">
          Decoración y estilo para tus espacios.
          Soluciones a la medida para transformar
          cada ambiente.
        </p>
        {redesActivas.length > 0 && (
          <div class="pie-redes" aria-label="Redes sociales">
            {redesActivas.map(red => (
              <a href={red.url} target="_blank" rel="noopener noreferrer" aria-label={`Visitar ${red.nombre} de MODEC`}>
                <img src={`/icons/${red.nombre.toLowerCase()}.svg`} alt="" width="22" height="22" loading="lazy" />
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- Navegación -->
      <nav class="pie-columna" aria-label="Navegación del pie de página">
        <h2>Explora</h2>
        {menu.map(([nombre, href]) => (
          <a href={nombre === 'Productos' ? '/productos' : href}>{nombre}</a>
        ))}
      </nav>

      <!-- Contacto -->
      <div class="pie-columna">
        <h2>Contacto</h2>
        <a href={`tel:+52${negocio.telefono.replace(/\D/g, '')}`}>
          <svg class="icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.8 19.8 0 0 1 3.09 5.18 2 2 0 0 1 5.08 3h3a2 2 0 0 1 2 1.72l.42 2.81a2 2 0 0 1-.57 1.7L8.1 11a16 16 0 0 0 4.9 4.9l1.77-1.83a2 2 0 0 1 1.7-.57l2.81.42A2 2 0 0 1 22 16.92Z" />
          </svg>
          <span>{negocio.telefono}</span>
        </a>
        {negocio.correo && (
          <a href={`mailto:${negocio.correo}`}>
            <svg class="icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="4" width="20" height="16" rx="2" />
              <path d="m3 6 9 7 9-7" />
            </svg>
            <span>{negocio.correo}</span>
          </a>
        )}
        <a href={negocio.ubicacionMaps} target="_blank" rel="noopener noreferrer">
          <svg class="icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z" />
            <circle cx="12" cy="10" r="2.5" />
          </svg>
          <span>Ver ubicación en Google Maps</span>
          <svg class="flecha" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7M8 7h9v9" />
          </svg>
        </a>
      </div>

      <!-- Atención -->
      <div class="pie-columna">
        <h2>Atención personalizada</h2>
        <p>
          ¿Tienes un proyecto en mente?
          Te ayudamos a encontrar la mejor
          solución para tu espacio.
        </p>
        <a class="enlace-atencion" href="/contacto">
          Solicitar asesoría
          <svg class="flecha" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7M8 7h9v9" />
          </svg>
        </a>
      </div>
    </div>

    <div class="pie-inferior">
      <p>© {anio} MODEC. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<style>
  .pie {
    background: var(--negro);
    color: var(--blanco);
    padding: 65px 24px 25px;
  }

  .pie-contenedor {
    max-width: 1300px;
    width: 100%;
    margin-inline: auto;
  }

  .pie-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.8fr 1.15fr 1fr;
    gap: 45px;
    align-items: start;
    padding-bottom: 45px;
  }

  .pie-identidad {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .pie-marca {
    display: inline-block;
    padding: 7px;
    background: var(--blanco);
    border-radius: 6px;
  }

  .pie-marca img {
    display: block;
    width: 170px;
    max-width: 100%;
    height: auto;
  }

  .pie-descripcion {
    max-width: 255px;
    color: var(--blanco);
    opacity: .85;
    font-family: var(--fuente-textos);
    font-size: 12px;
    line-height: 1.8;
  }

  .pie-redes {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pie-redes a {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    background: var(--blanco);
    border-radius: 50%;
    transition: transform .25s ease, background .25s ease;
  }

  .pie-redes img {
    width: 21px;
    height: 21px;
    object-fit: contain;
  }

  .pie-columna {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    min-width: 0;
  }

  .pie-columna h2 {
    color: var(--primario);
    font-family: var(--fuente-textos);
    font-size: 14px;
    font-weight: 700;
    margin-bottom: 9px;
  }

  .pie-columna a,
  .pie-columna p {
    color: var(--blanco);
    font-family: var(--fuente-textos);
    font-size: 12px;
    line-height: 1.7;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .pie-columna p { opacity: .9; }

  .pie-columna a {
    transition: color .25s ease;
  }

  .pie-columna a:has(.icono) {
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .pie-columna .icono {
    display: inline-block;
    flex: 0 0 17px;
    width: 17px;
    height: 17px;
    color: var(--primario);
  }

  .pie-columna .flecha {
    display: inline-block;
    flex: 0 0 14px;
    width: 14px;
    height: 14px;
    color: var(--primario);
    vertical-align: middle;
  }

  .pie-columna .enlace-atencion {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--primario);
    font-weight: 600;
    margin-top: 6px;
  }

  .pie-inferior {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
    text-align: center;
    padding-top: 22px;
    border-top: 1px solid var(--primario);
  }

  .pie-inferior p {
    color: var(--blanco);
    opacity: .78;
    font-family: var(--fuente-textos);
    font-size: 11px;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .pie-columna a:hover { color: var(--primario); }
    .pie-redes a:hover {
      transform: translateY(-3px);
      background: var(--primario);
    }
  }

  .pie a:focus-visible {
    outline: 2px solid var(--primario);
    outline-offset: 4px;
  }

  @media (max-width: 1000px) {
    .pie-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 35px;
    }
  }

  @media (max-width: 600px) {
    .pie { padding: 45px 18px 24px; }
    .pie-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 30px 18px;
      padding-bottom: 35px;
    }
    .pie-identidad { grid-column: 1 / -1; }
    .pie-columna:last-child { grid-column: 1 / -1; }
    .pie-inferior {
      flex-direction: column;
      align-items: center;
    }
  }

  @media (max-width: 380px) {
    .pie-grid { grid-template-columns: 1fr; }
    .pie-identidad,
    .pie-columna:last-child { grid-column: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pie a { transition: none; }
  }
</style>
