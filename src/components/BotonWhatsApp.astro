---
import { whatsapp } from '../data/modec';
---

<a
  class="whatsapp"
  href={whatsapp}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Contactar a MODEC por WhatsApp"
>
  <!-- Franja decorativa detrás del botón -->
  <span class="whatsapp-franja" aria-hidden="true"></span>

  <!-- Círculo principal -->
  <span class="whatsapp-circulo">
    <img
      src="/icons/whatsapp.svg"
      alt=""
      class="whatsapp-icono"
      width="39"
      height="39"
      aria-hidden="true"
    />
  </span>

  <!-- Punto rojo -->
  <span class="whatsapp-badge" aria-hidden="true"></span>

  <!-- Mensaje al pasar el cursor -->
  <span class="whatsapp-mensaje" aria-hidden="true">
    ¿Te asesoramos?
  </span>
</a>

<style>
  /* =========================================
     MODEC - WHATSAPP FLOTANTE
     ========================================= */

  .whatsapp {
    position: fixed;
    top: 50%;
    right: 24px;
    bottom: auto;
    left: auto;

    width: 68px;
    height: 68px;

    display: grid;
    place-items: center;

    transform: translateY(-50%);
    text-decoration: none;
    color: #FFFFFF;
    z-index: 9999;

    /* El botón no necesita fondo propio */
    background: transparent;
    isolation: isolate;
  }

  /* =========================================
     FRANJA DETRÁS DEL CÍRCULO
     ========================================= */

  .whatsapp-franja {
    position: absolute;

    top: 12%;
    left: 45%;

    width: calc(55% + 24px);
    height: 76%;

    background: rgb(0, 206, 75);

    border-radius: 0 3px 3px 0;

    z-index: 0;
    pointer-events: none;

    animation: franja-respirar 3.5s ease-in-out infinite;
  }

  /* =========================================
     CÍRCULO VERDE
     ========================================= */

  .whatsapp-circulo {
    position: relative;
    z-index: 1;

    width: 68px;
    height: 68px;

    display: grid;
    place-items: center;

    border-radius: 50%;
    background: #20B938;

    box-shadow:
      0 8px 24px rgba(0, 0, 0, 0.22),
      0 0 0 0 rgb(37, 211, 101);

    transition:
      transform 0.25s ease,
      background-color 0.25s ease,
      box-shadow 0.25s ease;

    animation: whatsapp-respirar 3.5s ease-in-out infinite;
  }

  /* =========================================
     ICONO EXTERNO
     ========================================= */

  .whatsapp-icono {
    display: block;
    width: 39px;
    height: 39px;
    object-fit: contain;
  }

  /* =========================================
     PUNTO ROJO
     ========================================= */

  .whatsapp-badge {
    position: absolute;
    top: 2px;
    right: 8px;

    width: 13px;
    height: 13px;

    background: #FF0038;
    border: 2px solid #FFFFFF;
    border-radius: 50%;

    z-index: 3;
  }

  /* =========================================
     TEXTO FLOTANTE
     ========================================= */

  .whatsapp-mensaje {
    position: absolute;
    right: calc(100% + 15px);
    top: 50%;

    transform: translate(8px, -50%);
    opacity: 0;
    visibility: hidden;

    padding: 10px 15px;
    border-radius: 8px;

    background: #30201D;
    color: #FFFFFF;

    font-family: var(--fuente-textos);
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;

    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.15);

    z-index: 2;
    pointer-events: none;

    transition:
      opacity 0.25s ease,
      transform 0.25s ease,
      visibility 0.25s ease;
  }

  /* =========================================
     ANIMACIONES
     ========================================= */

  @keyframes whatsapp-respirar {
    0%, 100% {
      box-shadow:
        0 8px 24px rgba(0, 0, 0, 0.22),
        0 0 0 0 rgba(37, 211, 102, 0.25);
    }

    50% {
      box-shadow:
        0 8px 24px rgba(0, 0, 0, 0.22),
        0 0 0 9px rgba(37, 211, 102, 0);
    }
  }

  @keyframes franja-respirar {
    0%, 100% {
      opacity: 0.45;
    }

    50% {
      opacity: 1;
    }
  }

  /* =========================================
     HOVER
     ========================================= */

  @media (hover: hover) and (pointer: fine) {
    .whatsapp:hover .whatsapp-circulo {
      background: #159D32;
      transform: scale(1.06);
      animation-play-state: paused;
    }

    .whatsapp:hover .whatsapp-mensaje {
      opacity: 1;
      visibility: visible;
      transform: translate(0, -50%);
    }

    .whatsapp:hover .whatsapp-franja {
      animation-play-state: paused;
    }
  }

  /* Navegación por teclado */
  .whatsapp:focus-visible {
    outline: 3px solid var(--primario);
    outline-offset: 6px;
    border-radius: 50%;
  }

  .whatsapp:focus-visible .whatsapp-mensaje {
    opacity: 1;
    visibility: visible;
    transform: translate(0, -50%);
  }

  /* =========================================
     MÓVIL
     ========================================= */

  @media (max-width: 700px) {
    .whatsapp {
      width: 56px;
      height: 56px;
      right: 16px;
    }

    .whatsapp-circulo {
      width: 56px;
      height: 56px;
    }

    .whatsapp-icono {
      width: 33px;
      height: 33px;
    }

    .whatsapp-franja {
      width: calc(55% + 16px);
    }

    .whatsapp-badge {
      width: 12px;
      height: 12px;
      right: 5px;
    }

    .whatsapp-mensaje {
      display: none;
    }
  }

  /* =========================================
     ACCESIBILIDAD
     ========================================= */

  @media (prefers-reduced-motion: reduce) {
    .whatsapp-circulo,
    .whatsapp-franja {
      animation: none;
    }

    .whatsapp-circulo,
    .whatsapp-mensaje {
      transition: none;
    }
  }
</style>
