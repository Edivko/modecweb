---
import { testimonios } from '../data/modec';

const datos = testimonios.length
  ? testimonios
  : [
      {
        nombre: 'Carlos R.',
        texto: 'Excelente servicio. Quedé muy satisfecho con la atención y la calidad de la instalación.',
        servicio: 'Persianas',
        detalle: 'Proyecto residencial',
        foto: '',
        destacado: false
      },
      {
        nombre: 'María G.',
        texto: 'Me encantó el resultado. Fueron puntuales y me ayudaron a elegir la mejor opción para mi espacio.',
        servicio: 'Cortinas',
        detalle: 'Atención personalizada',
        foto: '',
        destacado: true
      },
      {
        nombre: 'Luis A.',
        texto: 'Todo el proceso fue muy profesional. La instalación quedó excelente y los materiales se ven de calidad.',
        servicio: 'Piso laminado',
        detalle: 'Proyecto interior',
        foto: '',
        destacado: false
      }
    ];

const paginas = Math.max(1, datos.length - 2);

const iniciales = (nombre: string) =>
  nombre
    .split(' ')
    .map(parte => parte[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<section id="testimonios" aria-labelledby="titulo-testimonios">
  <div class="testimonios-contenedor">
    <div class="testimonios-encabezado">
      <p class="etiqueta">TESTIMONIOS</p>
      <h2 id="titulo-testimonios">Lo que dicen nuestros clientes</h2>
      <p class="subtexto">
        Experiencias reales que reflejan la atención, calidad y compromiso de MODEC.
      </p>
    </div>

    <div class="testimonios-carrusel">
      <div class="testimonios-track" id="lista-testimonios">
        {datos.map((item) => (
          <article
            class:list={{
              'testimonio-card': true,
              'destacado': item.destacado
            }}
          >
            <div class="card-superior">
              <span class="chip-servicio">{item.servicio}</span>
              <div class="estrellas" aria-label="Opinión destacada">
                <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
              </div>
            </div>

            <p class="texto-testimonio">
              “{item.texto}”
            </p>

            <div class="card-footer">
              <div class="avatar">
                {item.foto ? (
                  <img
                    src={item.foto}
                    alt={`Foto de ${item.nombre}`}
                    width="52"
                    height="52"
                    loading="lazy"
                  />
                ) : (
                  <span>{iniciales(item.nombre)}</span>
                )}
              </div>

              <div class="cliente-info">
                <h3>{item.nombre}</h3>
                <p>{item.detalle}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>

    <div class="indicadores-testimonios" aria-hidden="true">
      {Array.from({ length: paginas }).map((_, index) => (
        <span
          class:list={{
            'indicador-testimonio': true,
            'activo': index === 0
          }}
        ></span>
      ))}
    </div>

    <!-- Flechas en la esquina inferior derecha -->
    <div class="testimonios-controles">
      <button class="testimonio-flecha testimonio-anterior" type="button" aria-label="Testimonio anterior" aria-controls="lista-testimonios">
        <span aria-hidden="true">←</span>
      </button>
      <button class="testimonio-flecha testimonio-siguiente" type="button" aria-label="Siguiente testimonio" aria-controls="lista-testimonios">
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </div>
</section>

<script>
  const seccion = document.querySelector<HTMLElement>('#testimonios');

  if (seccion) {
    const track = seccion.querySelector<HTMLElement>('.testimonios-track');
    const botonAnterior = seccion.querySelector<HTMLButtonElement>('.testimonio-anterior');
    const botonSiguiente = seccion.querySelector<HTMLButtonElement>('.testimonio-siguiente');
    const indicadores = Array.from(
      seccion.querySelectorAll<HTMLElement>('.indicador-testimonio')
    );

    if (track) {
      const originales = Array.from(
        track.querySelectorAll<HTMLElement>('.testimonio-card')
      );
      const total = originales.length;

      // Duplicar solamente para que el carrusel pueda continuar sin detenerse.
      if (total > 1) {
        originales.forEach((tarjeta) => {
          const copia = tarjeta.cloneNode(true) as HTMLElement;
          copia.setAttribute('aria-hidden', 'true');
          copia.setAttribute('inert', '');
          track.appendChild(copia);
        });

        const reducido = window.matchMedia('(prefers-reduced-motion: reduce)');
        let posicion = 0;
        let temporizador: ReturnType<typeof setInterval> | undefined;
        let visible = false;
        let cursorEncima = false;
        let focoDentro = false;
        let transicionando = false;

        const paso = (): number => {
          const tarjeta = originales[0];
          if (!tarjeta) return 0;
          const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
          return tarjeta.getBoundingClientRect().width + gap;
        };

        const actualizarIndicadores = (): void => {
          indicadores.forEach((indicador, indice) => {
            indicador.classList.toggle('activo', indice === posicion % indicadores.length);
          });
        };

        const desplazar = (destino: number, suave: boolean): void => {
          // Anular temporalmente scroll-behavior CSS en el reinicio del bucle.
          track.style.scrollBehavior = suave ? 'smooth' : 'auto';
          track.scrollTo({ left: destino * paso(), behavior: suave ? 'smooth' : 'instant' });
        };

        const avanzar = (): void => {
          if (transicionando) return;
          posicion++;
          desplazar(posicion, true);
          actualizarIndicadores();

          // Las copias permiten volver al comienzo sin un salto visible.
          if (posicion === total) {
            transicionando = true;
            detener();
            window.setTimeout(() => {
              posicion = 0;
              desplazar(0, false);
              actualizarIndicadores();
              transicionando = false;
              iniciar();
            }, 850);
          }
        };

        const retroceder = (): void => {
          if (transicionando) return;
          if (posicion === 0) {
            // Ir instantáneamente a la copia del inicio y retroceder suavemente.
            transicionando = true;
            desplazar(total, false);
            posicion = total;
            window.requestAnimationFrame(() => {
              window.requestAnimationFrame(() => {
                posicion--;
                desplazar(posicion, true);
                actualizarIndicadores();
                window.setTimeout(() => { transicionando = false; }, 850);
              });
            });
          } else {
            posicion--;
            desplazar(posicion, true);
            actualizarIndicadores();
          }
        };

        const detener = (): void => {
          if (temporizador !== undefined) {
            clearInterval(temporizador);
            temporizador = undefined;
          }
        };

        const iniciar = (): void => {
          if (temporizador !== undefined || !visible || cursorEncima || focoDentro || document.hidden || reducido.matches) return;
          temporizador = window.setInterval(avanzar, 5000);
        };

        botonAnterior?.addEventListener('click', retroceder);
        botonSiguiente?.addEventListener('click', avanzar);

        seccion.addEventListener('pointerenter', () => { cursorEncima = true; detener(); });
        seccion.addEventListener('pointerleave', () => { cursorEncima = false; iniciar(); });
        seccion.addEventListener('focusin', () => { focoDentro = true; detener(); });
        seccion.addEventListener('focusout', (evento) => {
          focoDentro = evento.relatedTarget instanceof Node && seccion.contains(evento.relatedTarget);
          if (!focoDentro) iniciar();
        });

        document.addEventListener('visibilitychange', () => {
          if (document.hidden) detener(); else iniciar();
        });
        reducido.addEventListener('change', () => { detener(); iniciar(); });

        // Sólo animar mientras esta sección esté visible en pantalla.
        const observador = new IntersectionObserver((entradas) => {
          visible = entradas[0].isIntersecting;
          if (visible) iniciar(); else detener();
        }, { threshold: 0.15 });
        observador.observe(seccion);

        // Recalcular la posición cuando cambia el ancho de las tarjetas.
        window.addEventListener('resize', () => desplazar(posicion, false));
      }
    }
  }
</script>

<style>
  /* ======================================
     MODEC - TESTIMONIOS
     ====================================== */

  #testimonios {
    position: relative;
    background:
      linear-gradient(rgba(0, 0, 0, 0.78), rgb(0, 0, 0)),
      radial-gradient(circle at top left, rgba(244, 152, 26, 0.12), transparent 35%),
      radial-gradient(circle at bottom right, rgba(252, 192, 9, 0.12), transparent 30%),
      #1d1b14;
    padding: 70px 20px;
    overflow: hidden;
  }

  #testimonios::before,
  #testimonios::after {
    content: "";
    position: absolute;
    inset: auto;
    width: 320px;
    height: 320px;
    background: linear-gradient(135deg, rgb(252, 192, 9), rgba(255,255,255,0));
    clip-path: polygon(0 0, 100% 30%, 55% 100%, 0 70%);
    pointer-events: none;
  }

  #testimonios::before {
    top: 40px;
    right: -70px;
  }

  #testimonios::after {
    bottom: 20px;
    left: -90px;
    transform: rotate(180deg);
  }

  .testimonios-contenedor {
    position: relative;
    max-width: 1300px;
    margin-inline: auto;
    z-index: 1;
  }

  /* Encabezado */
  .testimonios-encabezado {
    text-align: center;
    margin-bottom: 34px;
  }

  .etiqueta {
    display: inline-block;
    color: var(--primario);
    font-family: var(--fuente-textos);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 10px;
  }

  .testimonios-encabezado h2 {
    font-family: var(--fuente-titulos);
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 400;
    line-height: 1.15;
    text-transform: uppercase;
    color: #FFFFFF;
  }

  .subtexto {
    max-width: 560px;
    margin: 14px auto 0;
    color: #D9D2CD;
    font-family: var(--fuente-textos);
    font-size: 13px;
    line-height: 1.7;
  }

  /* Carrusel */
  .testimonios-carrusel {
    position: relative;
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .testimonios-track {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    width: 100%;
    padding: 8px 2px;
  }

  .testimonios-track::-webkit-scrollbar {
    display: none;
  }

  /* Cards */
  .testimonio-card {
    flex: 0 0 calc((100% - 36px) / 3);
    min-height: 290px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 22px 20px;
    border-radius: 18px;
    scroll-snap-align: start;
    background: var(--blanco);
    color: #2C1B17;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.16);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .testimonio-card:nth-child(3n) {
    background: var(--blanco);
  }

  .testimonio-card.destacado {
    background: var(--primario);
    color: #2C1B17;
  }

  .card-superior {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .chip-servicio {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 6px 10px;
    border-radius: 999px;
    background: rgba(48, 32, 29, 0.08);
    color: #2C1B17;
    font-family: var(--fuente-textos);
    font-size: 11px;
    font-weight: 600;
  }

  .destacado .chip-servicio {
    background: rgba(48, 32, 29, 0.12);
  }

  .estrellas {
    color: var(--primario);
    font-size: 13px;
    letter-spacing: 1px;
    flex-shrink: 0;
  }

  .texto-testimonio {
    margin: 18px 0 24px;
    color: #2C1B17;
    font-family: var(--fuente-textos);
    font-size: 14px;
    line-height: 1.75;
  }

  .card-footer {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
  }

  .avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    background: rgba(48, 32, 29, 0.12);
    color: #2C1B17;
    font-family: var(--fuente-textos);
    font-size: 15px;
    font-weight: 700;
  }

  .avatar img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cliente-info h3 {
    color: #2C1B17;
    font-family: var(--fuente-textos);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.2;
  }

  .cliente-info p {
    margin-top: 4px;
    color: #5B4B43;
    font-family: var(--fuente-textos);
    font-size: 12px;
    line-height: 1.4;
  }



  /* Indicadores */
  .indicadores-testimonios {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
  }

  .indicador-testimonio {
    display: inline-block;
    width: 9px;
    height: 9px;
    border: 0;
    border-radius: 50%;
    background: rgba(255,255,255,0.35);
    cursor: default;
    transition:
      transform 0.25s ease,
      background 0.25s ease,
      width 0.25s ease;
  }

  .indicador-testimonio.activo {
    width: 28px;
    border-radius: 999px;
    background: var(--primario);
  }

  /* Flechas de navegación: esquina inferior derecha */
  .testimonios-controles {
    position: absolute;
    right: 0;
    bottom: -25px;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .testimonio-flecha {
    width: 54px;
    height: 54px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    font-size: 24px;
    font-weight: 400;
    line-height: 1;
    cursor: pointer;
    transition: transform 0.25s ease, background-color 0.25s ease;
  }

  .testimonio-anterior {
    background: rgba(255, 255, 255, 0.07);
    color: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.23);
  }

  .testimonio-siguiente {
    background: var(--primario);
    color: #171717;
    border: 1px solid var(--primario);
  }

  .testimonio-flecha:focus-visible {
    outline: 2px solid var(--primario);
    outline-offset: 3px;
  }

  /* Hover */
  @media (hover: hover) and (pointer: fine) {
    .testimonio-flecha:hover {
      transform: translateY(-2px);
    }

    .testimonio-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 18px 44px rgba(0, 0, 0, 0.20);
    }



  }

  /* Tablet */
  @media (max-width: 1050px) {
    .testimonio-card {
      flex-basis: calc((100% - 18px) / 2);
      min-height: 285px;
    }
  }

  /* Móvil */
  @media (max-width: 700px) {
    #testimonios {
      padding: 50px 14px;
    }

    .testimonios-carrusel {
      gap: 10px;
    }

    .testimonio-card {
      flex-basis: 100%;
      min-height: 270px;
      padding: 20px 18px;
    }


    .texto-testimonio {
      font-size: 13px;
      line-height: 1.7;
    }

    .cliente-info h3 {
      font-size: 17px;
    }
  }

  @media (max-width: 700px) {
    .testimonios-controles {
      position: static;
      justify-content: flex-end;
      margin-top: 15px;
    }

    .testimonio-flecha {
      width: 48px;
      height: 48px;
      font-size: 22px;
    }
  }

  /* Accesibilidad */
  @media (prefers-reduced-motion: reduce) {
    .testimonios-track,
    .testimonio-card,
    .indicador-testimonio,
    .testimonio-flecha {
      transition: none;
      scroll-behavior: auto;
    }
  }
  
</style>