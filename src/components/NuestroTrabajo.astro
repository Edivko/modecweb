
---
const trabajos = [
  { imagen: '/images/trabajos/trabajo-01.webp', alt: 'Proyecto de persianas', categoria: 'Persianas' },
  { imagen: '/images/trabajos/trabajo-02.webp', alt: 'Proyecto de cortinas', categoria: 'Cortinas' },
  { imagen: '/images/trabajos/trabajo-03.webp', alt: 'Proyecto de decoración de interiores', categoria: 'Decoración' },
  { imagen: '/images/trabajos/trabajo-04.webp', alt: 'Proyecto de decoración de muros', categoria: 'Muros' },
  { imagen: '/images/trabajos/trabajo-05.webp', alt: 'Proyecto de instalación de pisos', categoria: 'Pisos' },
  { imagen: '/images/trabajos/trabajo-06.webp', alt: 'Proyecto de instalación de toldos', categoria: 'Toldos' },
  { imagen: '/images/trabajos/trabajo-07.webp', alt: 'Proyecto de cortinas para interiores', categoria: 'Cortinas' },
  { imagen: '/images/trabajos/trabajo-08.webp', alt: 'Proyecto de persianas para interiores', categoria: 'Persianas' },
  { imagen: '/images/trabajos/trabajo-09.webp', alt: 'Proyecto de decoración residencial', categoria: 'Decoración' }
];
---

<section id="nuestro-trabajo" aria-labelledby="titulo-trabajos">
  <div class="trabajos-contenedor">

    <header class="trabajos-encabezado">
      <p class="trabajos-etiqueta">PORTAFOLIO MODEC</p>

      <h2 id="titulo-trabajos">NUESTRO TRABAJO</h2>

      <p>
        Conoce algunos de los espacios que hemos transformado
        con dedicación, calidad y atención a cada detalle.
      </p>
    </header>

    <div class="trabajos-galeria">
      {trabajos.map((trabajo, index) => (
        <figure class={`trabajo-item trabajo-${index + 1}`}>
          <img
            src={trabajo.imagen}
            alt={trabajo.alt}
            loading="lazy"
            decoding="async"
            width="800"
            height="600"
          />

          <figcaption>
            <span>{trabajo.categoria}</span>
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="trabajos-acciones">
      <a href="/galeria" class="trabajos-boton">
        Ver todos nuestros proyectos
        <span aria-hidden="true">↗</span>
      </a>
    </div>

  </div>
</section>

<style>
  /* ==================================
     MODEC - NUESTRO TRABAJO
     ================================== */

  #nuestro-trabajo {
    padding: 85px 24px;
    background: var(--blanco);
  }

  .trabajos-contenedor {
    width: 100%;
    max-width: 1300px;
    margin: 0 auto;
  }

  /* Encabezado */

  .trabajos-encabezado {
    text-align: center;
    margin-bottom: 38px;
  }

  .trabajos-etiqueta {
    margin-bottom: 12px;
    font-family: var(--fuente-textos);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--naranja);
  }

  .trabajos-encabezado h2 {
    font-family: var(--fuente-titulos);
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 400;
    color: var(--negro);
  }

  .trabajos-encabezado > p:last-child {
    max-width: 590px;
    margin: 14px auto 0;
    font-family: var(--fuente-textos);
    font-size: 14px;
    line-height: 1.8;
    color: var(--negro);
  }

  /* ==================================
     GALERÍA TIPO MOSAICO
     ================================== */

  .trabajos-galeria {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-rows: repeat(4, 155px);
    grid-template-areas:
      "a a b c"
      "a a d d"
      "e f d d"
      "g g h i";
    gap: 12px;
  }

  .trabajo-1 { grid-area: a; }
  .trabajo-2 { grid-area: b; }
  .trabajo-3 { grid-area: c; }
  .trabajo-4 { grid-area: d; }
  .trabajo-5 { grid-area: e; }
  .trabajo-6 { grid-area: f; }
  .trabajo-7 { grid-area: g; }
  .trabajo-8 { grid-area: h; }
  .trabajo-9 { grid-area: i; }

  .trabajo-item {
    position: relative;
    min-width: 0;
    min-height: 0;
    margin: 0;
    overflow: hidden;
    border-radius: 12px;
    background: #CFC9C2;
  }

  .trabajo-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  /* Degradado para etiquetas */

  .trabajo-item::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.55),
      transparent 45%
    );
    pointer-events: none;
  }

  .trabajo-item figcaption {
    position: absolute;
    bottom: 16px;
    left: 18px;
    z-index: 1;
  }

  .trabajo-item figcaption span {
    font-family: var(--fuente-textos);
    font-size: 12px;
    font-weight: 600;
    color: #FFFFFF;
  }

  /* ==================================
     BOTÓN
     ================================== */

  .trabajos-acciones {
    display: flex;
    justify-content: center;
    margin-top: 34px;
  }

  .trabajos-boton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 25px;
    min-height: 48px;
    padding: 13px 26px;

    border-radius: 30px;
    background: var(--negro);
    color: #FFFFFF;

    font-family: var(--fuente-textos);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;

    transition:
      background 0.25s ease,
      transform 0.25s ease;
  }

  .trabajos-boton span {
    font-size: 19px;
  }

  .trabajos-boton:focus-visible {
    outline: 2px solid #211B16;
    outline-offset: 4px;
  }

  @media (hover: hover) and (pointer: fine) {
    .trabajo-item:hover img {
      transform: scale(1.06);
    }

    .trabajos-boton:hover {
      background: var(--secundario);
      transform: translateY(-2px);
    }
  }

  /* ==================================
     TABLET
     ================================== */

  @media (max-width: 950px) {
    .trabajos-galeria {
      grid-template-rows: repeat(4, 125px);
      gap: 10px;
    }
  }

  /* ==================================
     MÓVIL
     ================================== */

  @media (max-width: 650px) {
    #nuestro-trabajo {
      padding: 55px 15px;
    }

    .trabajos-encabezado {
      margin-bottom: 28px;
    }

    .trabajos-galeria {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: repeat(8, 120px);
      grid-template-areas:
        "a a"
        "a a"
        "b c"
        "d d"
        "d d"
        "e f"
        "g g"
        "h i";
      gap: 9px;
    }

    .trabajo-item {
      border-radius: 9px;
    }

    .trabajo-item figcaption {
      bottom: 12px;
      left: 12px;
    }

    .trabajos-boton {
      width: 100%;
      max-width: 340px;
      gap: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trabajo-item img,
    .trabajos-boton {
      transition: none;
    }
  }
</style>
