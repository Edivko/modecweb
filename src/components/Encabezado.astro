
---
import { negocio, menu } from '../data/modec';
import MenuProductos from './catalogo/MenuProductos.astro';
---

<!-- BARRA SUPERIOR -->
<div class="barra">
  <div class="barra-interior">

    <div class="datos">
      {negocio.correo && (
        <a class="dato-correo" href={`mailto:${negocio.correo}`}>
          <span class="icono-encabezado" aria-hidden="true">
            <img src="/icons/gmail.svg" alt="" />
          </span>
          {negocio.correo}
        </a>
      )}

      <a
        href={`tel:+52${negocio.telefono.replace(/\D/g, '')}`}
        aria-label={`Llamar a MODEC: ${negocio.telefono}`}
      >
        <span class="icono-encabezado" aria-hidden="true">
          <img src="/icons/telefono.svg" alt="" />
        </span>
        {negocio.telefono}
      </a>
    </div>

    <div class="redes" aria-label="Redes sociales">
      {negocio.redes.map(red => (
        red.url ? (
          <a
            class="red-social"
            href={red.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="icono-encabezado" aria-hidden="true">
              <img
                src={`/icons/${red.nombre.toLowerCase()}.svg`}
                alt=""
              />
            </span>
            {red.nombre}
          </a>
        ) : (
          <span class="red-social">
            <span class="icono-encabezado" aria-hidden="true">
              <img
                src={`/icons/${red.nombre.toLowerCase()}.svg`}
                alt=""
              />
            </span>
            {red.nombre}
          </span>
        )
      ))}
    </div>

  </div>
</div>

<!-- NAVEGACIÓN PRINCIPAL -->
<header class="cabecera">
  <div class="navegacion">

    <a class="marca" href="/" aria-label="MODEC, inicio">
      <img
        src="/images/logo.jpeg"
        alt="MODEC — Decoración integral"
        width="230"
        height="64"
      />
    </a>

    <button
      class="menu-boton"
      type="button"
      aria-expanded="false"
      aria-controls="menu-principal"
    >
      Menú <span aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block;vertical-align:-0.12em;flex-shrink:0" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></span>
    </button>


<nav id="menu-principal" aria-label="Navegación principal">
  {menu.map(([nombre, href]) =>
    nombre === 'Productos' ? (
      <MenuProductos />
    ) : (
      <a
        href={href}
        class:list={{ 'nav-contacto': nombre === 'Contacto' }}
      >
        {nombre}
      </a>
    )
  )}
</nav>


  </div>
</header>

<script>
  import "../scripts/menu.ts";
</script>

<style>
  /* ==================================
     BARRA SUPERIOR
     ================================== */

  .barra {
    background: var(--blanco);
    color: var(--negro);
    font-size: 12px;
  }

  .barra-interior {
    width: 89%;
    max-width: 1600px;
    min-height: 28px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .datos,
  .redes {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .datos a,
  .red-social {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .dato-correo {
    font-size: 11px;
  }

  .datos a:last-child {
    font-size: 14px;
    line-height: 1.2;
  }

  .icono-encabezado {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 17px;
    height: 17px;
    flex: 0 0 17px;
  }

  .icono-encabezado img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .redes {
    gap: 20px;
    margin-left: auto;
    font-size: 12px;
  }

  /* ==================================
     NAVBAR
     ================================== */

  .cabecera {
    background: #FFFFFF;
  }

  .navegacion {
    width: 89%;
    max-width: 1600px;
    min-height: 68px;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3%;
  }

  /* Logotipo */
  .marca {
    flex: 0 0 25%;
    height: 56px;
    display: flex;
    align-items: center;
    padding-right: 25px;
    border-right: 1px solid #777;
  }

  .marca img {
    width: 205px;
    height: auto;
    max-height: 56px;
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
  }

  /* Enlaces del menú */
  #menu-principal {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    font-size: 13px;
  }

  #menu-principal a:hover {
    color: var(--naranja);
  }

  /* Botón de contacto */
  .nav-contacto {
    min-width: 118px;
    padding: 6px 12px;
    background: var(--negro);
    color: var(--blanco) !important;
    border: 1px solid var(--naranja);
    border-radius: 9px;
    text-align: center;
    font-size: 13px;
    line-height: 1.3;
  }

  /* Menú móvil: oculto en escritorio */
  .menu-boton {
    display: none;
  }

  /* ==================================
     RESPONSIVE
     ================================== */

  /* Tablets */
  @media (min-width: 801px) and (max-width: 1100px) {
    .barra-interior,
    .navegacion {
      width: 94%;
    }

    .redes {
      gap: 16px;
      font-size: 11px;
    }

    .datos {
      gap: 12px;
    }

    .datos a:last-child {
      font-size: 21px;
    }

    .dato-correo {
      font-size: 11px;
    }

    .navegacion {
      gap: 3%;
    }

    .marca {
      flex-basis: 24%;
      padding-right: 20px;
    }

    #menu-principal {
      gap: 12px;
      font-size: 12px;
    }

    .nav-contacto {
      min-width: 120px;
      font-size: 18px;
      padding-inline: 16px;
    }
  }

  @media (max-width: 1050px) {
    .marca {
      flex-basis: 25%;
    }

    #menu-principal {
      gap: 10px;
    }
  }

  /* Tablets pequeñas y celulares */
  @media (max-width: 800px) {
    .barra-interior {
      width: calc(100% - 32px);
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px 20px;
      padding-block: 8px;
    }

    .datos {
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px 18px;
    }

    .datos a:last-child {
      font-size: 20px;
    }

    .dato-correo {
      font-size: 12px;
    }

    .redes {
      margin-left: 0;
      gap: 24px;
      font-size: 12px;
    }

    .icono-encabezado {
      width: 20px;
      height: 20px;
      flex-basis: 20px;
    }

    .navegacion {
      width: calc(100% - 36px);
      flex-wrap: wrap;
      gap: 0;
      padding-block: 14px;
      min-height: 80px;
    }

    .marca {
      flex: 0 1 240px;
      height: 60px;
      border: 0;
      padding: 0;
    }

    .marca img {
      width: 210px;
      height: 60px;
    }

    .menu-boton {
      display: block;
      border: 1px solid #ccc;
      background: white;
      padding: 10px 14px;
      cursor: pointer;
    }

    #menu-principal {
      flex: 0 0 100%;
      flex-direction: column;
      align-items: stretch;
      padding-top: 18px;
      gap: 8px;
      font-size: 14px;
      display: none;
    }

    #menu-principal.abierto {
      display: flex;
    }

    #menu-principal a {
      padding: 12px;
      font-size: 14px;
    }

    .nav-contacto {
      min-width: 0;
      font-size: 18px;
    }

    /* Menú antes de inicializar el script */
    .navegacion:not(.menu-listo) #menu-principal {
      display: flex;
    }

    .navegacion:not(.menu-listo) .menu-boton {
      display: none;
    }
  }

  /* Celulares pequeños */
  @media (max-width: 500px) {
    .datos {
      gap: 10px;
      flex-wrap: wrap;
    }
  }

  @media (max-width: 380px) {
    .marca {
      flex-basis: 185px;
    }

    .marca img {
      width: 175px;
    }

    .redes {
      gap: 16px;
    }
  }

  /* MODEC: botón de menú móvil con colores de la marca (sin azul nativo) */
  .menu-boton {
    color: var(--negro);
    background-color: var(--blanco);
    border: 1px solid var(--negro);
    border-radius: 6px;
    font-family: var(--fuente-textos);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    -webkit-appearance: none;
    appearance: none;
    -webkit-text-fill-color: var(--negro);
  }
  .menu-boton svg { color: var(--negro); }

</style>
