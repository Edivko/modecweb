
---
import { pasos } from '../data/modec';

// Información complementaria de cada etapa
const descripciones = [
  'Te ayudamos a elegir la solución adecuada.',
  'Tomamos medidas para lograr un ajuste preciso.',
  'Cuidamos cada detalle durante la instalación.',
  'Te orientamos sobre el cuidado de tus productos.'
];

// Colores del semicírculo
const colores = [
  '#FCC009',
  '#000000',
  '#E5E4E1',
  '#F8AB14'
];

// Calcula los segmentos del semicírculo
const punto = (radio: number, angulo: number) => {
  const rad = angulo * Math.PI / 180;

  return {
    x: 115 + radio * Math.cos(rad),
    y: 210 + radio * Math.sin(rad)
  };
};

const segmentos = pasos.map((nombre, index) => {
  const inicio = -90 + index * 45;
  const fin = inicio + 45;

  const a = punto(177, inicio);
  const b = punto(177, fin);
  const c = punto(107, fin);
  const d = punto(107, inicio);
  const centro = punto(142, (inicio + fin) / 2);

  return {
    nombre,
    numero: String(index + 1).padStart(2, '0'),
    color: colores[index],
    x: centro.x,
    y: centro.y,
    ruta: `
      M ${a.x} ${a.y}
      A 177 177 0 0 1 ${b.x} ${b.y}
      L ${c.x} ${c.y}
      A 107 107 0 0 0 ${d.x} ${d.y}
      Z
    `
  };
});
---

<section id="servicios" aria-labelledby="titulo-servicios">
  <div class="servicios-contenedor">

    <!-- Encabezado -->
    <div class="servicios-encabezado">
      <p class="etiqueta">NUESTROS SERVICIOS</p>

      <h2 id="titulo-servicios">
        Instalación profesional y especializada
      </h2>

      <p class="subtitulo">
        Cuidamos cada detalle, desde la asesoría
        hasta la instalación.
      </p>
    </div>

    <!-- Composición principal -->
    <div class="servicios-grid">

      <!-- Fotografía lateral -->
      <div class="servicios-foto">
        <img
          src="/images/fondo_hero.webp"
          alt="Instalación de persianas de MODEC"
          width="350"
          height="750"
          loading="lazy"
        />

        <div class="foto-etiqueta">
          <span>MODEC</span>
          <p>DECORACIÓN INTEGRAL</p>
        </div>
      </div>

      <!-- Semicírculo interactivo -->
      <div class="proceso-grafico">
        <svg
          viewBox="0 0 330 420"
          xmlns="http://www.w3.org/2000/svg"
          role="group"
          aria-label="Proceso MODEC de cuatro etapas"
        >
          <defs>
            <filter id="sombra-proceso"
              x="-20%" y="-20%"
              width="140%" height="140%">
              <feDropShadow
                dx="0"
                dy="4"
                stdDeviation="5"
                flood-opacity="0.16"
              />
            </filter>
          </defs>

          <!-- Cuatro segmentos -->
          {segmentos.map((segmento, index) => (
            <g
              class="segmento"
              data-paso={index}
              role="button"
              tabindex="0"
              aria-label={`${segmento.numero}. ${segmento.nombre}`}
            >
              <path
                d={segmento.ruta}
                fill={segmento.color}
                stroke="#FFFFFF"
                stroke-width="3"
              />

              <text
                x={segmento.x}
                y={segmento.y}
                text-anchor="middle"
                dominant-baseline="middle"
                class:list={{
                  'numero-claro': index === 1 || index === 3
                }}
              >
                {segmento.numero}
              </text>
            </g>
          ))}

          <!-- Centro del semicírculo -->
          <circle
            cx="115"
            cy="210"
            r="90"
            fill="#F5EFEC"
            stroke="#E4D6D0"
            stroke-width="3"
            filter="url(#sombra-proceso)"
            pointer-events="none"
          />

          <text x="115" y="199"
            text-anchor="middle"
            class="centro-titulo"
            pointer-events="none">
            NUESTRO
          </text>

          <text x="115" y="220"
            text-anchor="middle"
            class="centro-titulo"
            pointer-events="none">
            PROCESO
          </text>

          <text x="115" y="240"
            text-anchor="middle"
            class="centro-subtitulo"
            pointer-events="none">
            MODEC · 4 ETAPAS
          </text>
        </svg>
      </div>

      <!-- Descripción de etapas -->
      <div class="servicios-contenido">
        <ol class="lista-pasos">
          {pasos.map((paso, index) => (
            <li class="paso" data-paso={index}>
              <span class="paso-linea" aria-hidden="true"></span>

              <div class="paso-informacion">
                <span class="paso-indice">
                  {String(index + 1).padStart(2, '0')}
                </span>

                <div>
                  <h3>{paso}</h3>
                  <p>{descripciones[index]}</p>
                </div>

                <span class="paso-flecha" aria-hidden="true">
                  ↗
                </span>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <!-- Acciones -->
    <div class="servicios-acciones">
      <p>
        Atención personalizada en cada etapa
        de tu proyecto.
      </p>

      <div class="grupo-botones">
        <a class="boton-secundario" href="/servicios">
          Servicios que ofrecemos
          <span aria-hidden="true">↗</span>
        </a>

        <a class="boton-principal" href="/contacto">
          Agendar servicio
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

  </div>
</section>

<script>
  const seccion = document.querySelector<HTMLElement>('#servicios');

  if (seccion) {
    const segmentos = seccion.querySelectorAll<SVGGElement>(
      '.segmento'
    );

    const tarjetas = seccion.querySelectorAll<HTMLElement>(
      '.paso'
    );

    const activar = (index: string | null) => {
      segmentos.forEach(segmento => {
        segmento.classList.toggle(
          'activo',
          segmento.dataset.paso === index
        );
      });

      tarjetas.forEach(tarjeta => {
        tarjeta.classList.toggle(
          'activo',
          tarjeta.dataset.paso === index
        );
      });
    };

    segmentos.forEach(segmento => {
      segmento.addEventListener('pointerenter', () => {
        activar(segmento.dataset.paso ?? null);
      });

      segmento.addEventListener('click', () => {
        activar(segmento.dataset.paso ?? null);
      });

      segmento.addEventListener('focus', () => {
        activar(segmento.dataset.paso ?? null);
      });

      segmento.addEventListener('keydown', evento => {
        if (evento.key === 'Enter' || evento.key === ' ') {
          evento.preventDefault();
          activar(segmento.dataset.paso ?? null);
        }
      });
    });

    tarjetas.forEach(tarjeta => {
      tarjeta.addEventListener('pointerenter', () => {
        activar(tarjeta.dataset.paso ?? null);
      });
    });

    seccion.addEventListener('pointerleave', () => {
      activar(null);
    });

    seccion.addEventListener('focusout', evento => {
      const destino = evento.relatedTarget;
      if (!(destino instanceof Node) || !seccion.contains(destino)) {
        activar(null);
      }
    });
  }
</script>

<style>
  /* ==================================
     MODEC - SERVICIOS
     ================================== */

  #servicios {
    background: var(--blanco);
    padding: 65px 20px;
  }

  .servicios-contenedor {
    max-width: 1300px;
    margin-inline: auto;
    padding: 45px 40px;
    background: #FFFFFF;
    border-radius: 22px;
    overflow: hidden;
  }

  /* Encabezado */
  .servicios-encabezado {
    text-align: center;
    margin-bottom: 32px;
  }

  .etiqueta {
    color: var(--naranja);
    font-family: var(--fuente-textos);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1px;
    margin-bottom: 10px;
  }

  .servicios-encabezado h2 {
    font-family: var(--fuente-titulos);
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 400;
    color: #24201E;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .subtitulo {
    margin-top: 12px;
    font-family: var(--fuente-textos);
    font-size: 12px;
    color: #77706A;
  }

  /* Composición principal */
  .servicios-grid {
    display: grid;
    grid-template-columns: 26% 32% minmax(0, 1fr);
    align-items: center;
    gap: 18px;
  }

  /* Fotografía */
  .servicios-foto {
    position: relative;
    height: 420px;
    overflow: hidden;
    border-radius: 12px;
    background: #302722;
    z-index: 1;
  }

  .servicios-foto img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .foto-etiqueta {
    position: absolute;
    inset: auto 0 0;
    padding: 40px 15px 20px;
    background: linear-gradient(
      transparent,
      rgba(0,0,0,0.85)
    );
    color: white;
  }

  .foto-etiqueta span {
    font-family: var(--fuente-titulos);
    font-size: 25px;
    color: var(--primario);
  }

  .foto-etiqueta p {
    font-family: var(--fuente-textos);
    font-size: 9px;
    letter-spacing: 1px;
  }

  /* Semicírculo */
  .proceso-grafico {
    display: grid;
    place-items: center;
    min-width: 0;
    position: relative;
    z-index: 2;
    /* Superpone el centro del círculo al borde de la fotografía. */
    margin-left: -145px;
    width: calc(100% + 110px);
  }

  .proceso-grafico svg {
    display: block;
    width: 100%;
    max-height: 440px;
    overflow: visible;
  }

  .segmento {
    cursor: pointer;
    outline: none;
  }

  .segmento path {
    transition:
      filter 0.25s ease,
      stroke-width 0.25s ease;
  }

  .segmento text {
    font-family: var(--fuente-textos);
    font-size: 24px;
    fill: #30201D;
    pointer-events: none;
  }

  .segmento text.numero-claro {
    fill: #FFFFFF;
  }

  .segmento.activo path,
  .segmento:focus-visible path {
    filter: brightness(1.12);
    stroke-width: 6px;
  }

  .centro-titulo {
    font-family: var(--fuente-titulos);
    font-size: 19px;
    fill: #30201D;
  }

  .centro-subtitulo {
    font-family: var(--fuente-textos);
    font-size: 9px;
    fill: #9A7462;
    letter-spacing: 0.5px;
  }

  /* Etapas */
  .lista-pasos {
    display: grid;
    gap: 12px;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .paso {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 10px;
  }

  .paso-linea {
    width: 25px;
    height: 1px;
    flex-shrink: 0;
    background: #BEA18E;
  }

  .paso-informacion {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 17px 14px;
    background: #F5F1EE;
    border-left: 3px solid var(--naranja);
    border-radius: 7px;
    transition:
      background 0.25s ease,
      transform 0.25s ease;
  }

  .paso-indice {
    font-family: var(--fuente-titulos);
    font-size: 23px;
    color: var(--naranja);
  }

  .paso-informacion div {
    flex: 1;
    min-width: 0;
  }

  .paso-informacion h3 {
    font-family: var(--fuente-textos);
    font-size: 13px;
    font-weight: 700;
    color: #30201D;
  }

  .paso-informacion p {
    font-family: var(--fuente-textos);
    font-size: 11px;
    line-height: 1.4;
    color: #77706A;
    margin-top: 4px;
  }

  .paso-flecha {
    color: var(--naranja);
    font-size: 18px;
  }

  .paso.activo .paso-informacion {
    background: #30201D;
    transform: translateX(4px);
  }

  .paso.activo h3,
  .paso.activo p {
    color: #FFFFFF;
  }

  /* Acciones */
  .servicios-acciones {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 30px;
  }

  .servicios-acciones > p {
    color: #77706A;
    font-family: var(--fuente-textos);
    font-size: 11px;
  }

  .grupo-botones {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 12px;
  }

  .boton-principal,
  .boton-secundario {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 13px 20px;
    border-radius: 30px;
    font-family: var(--fuente-textos);
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.25s ease;
  }

  .boton-principal {
    background: #30201D;
    color: white;
  }

  .boton-secundario {
    background: var(--primario);
    color: #30201D;
    list-style: none;
  }

  /* Microinteracciones */
  @media (hover: hover) and (pointer: fine) {
    .boton-principal:hover,
    .boton-secundario:hover {
      transform: translateY(-3px);
    }
  }

  /* Tablet */
  @media (max-width: 1000px) {
    .servicios-grid {
      grid-template-columns: 27% 33% minmax(0, 1fr);
      gap: 10px;
    }

    .servicios-contenedor {
      padding: 30px 22px;
    }

    .proceso-grafico {
      margin-left: -105px;
      width: calc(100% + 85px);
    }

    .paso-linea {
      width: 12px;
    }
  }

  /* Móvil */
  @media (max-width: 700px) {
    #servicios {
      padding: 40px 12px;
    }

    .servicios-contenedor {
      padding: 28px 16px;
    }

    .servicios-grid {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .servicios-foto {
      height: 170px;
    }

    .proceso-grafico {
      margin-left: 0;
      width: 100%;
    }

    .proceso-grafico svg {
      max-width: 350px;
    }

    .paso-linea {
      display: none;
    }

    .servicios-acciones {
      flex-direction: column;
      align-items: stretch;
    }

    .grupo-botones {
      justify-content: center;
    }

  }

  @media (prefers-reduced-motion: reduce) {
    .segmento path,
    .paso-informacion,
    .boton-principal,
    .boton-secundario {
      transition: none;
    }
  }
</style>
